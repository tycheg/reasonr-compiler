test "Customers in a week"
  given
    time offset -7d
    for day in range(7)
      let c = new Customer.Id
      [c].SignUp(customerName: faker.name()) as c
      let n = faker.int(1, 3)
      while n > 0
        [c].Visit() as c
        n = n - 1
      if faker.chance(0.5)
        [c].Visit() as c
      time offset +1d
    let who = faker.pick(["Ann", "Boris"])
    let plate = faker.pattern("?###??77")
    let unknown = faker.nickname()  # want "E0221"

test "A demo with a check"
  let c = new Customer.Id
  given
    [c].SignUp(customerName: "Ann") as c
  when  # want "E0805"
    [c].Visit() as c
