  status Ordering.OrderStatus
  driverName string?
  plate string?
  placedAt timestamp
  index byStatus
  query Board(wanted Ordering.OrderStatus, pageReq PageRequest) page<Ordering.BoardRow> [role dispatcher]
external Ordering.Payments (id uuid)
  limit decimal
  request charge(paymentId Ordering.Order.Id, amount Ordering.Money)
  command Setup(limitAmount decimal)
  event configured(limitAmount decimal)
  command capture(paymentId Ordering.Order.Id)
actor Ordering.Customer (id uuid)
  phone string? personal
  blocked bool
  activeOrder Ordering.Order.Id?
  homeAddress string?
  index byPhone
  command SignUp(phoneNumber string) [self self]
  command Join(phoneNumber string) [self self]
  command SetHome(address string) [self self]
  command OrderTaxi(orderId Ordering.Order.Id, orderRoute Ordering.Route, requestedClass Ordering.CarClass) [self self, role admin, role support]
  command Forget() [self self, role support]
  command orderFinished(orderId Ordering.Order.Id)
  command orderUnpaid(orderId Ordering.Order.Id)
  event signedUp(phoneNumber string?)
  event joined(phoneNumber string?)
  event homeSet(address string)
  event orderStarted(orderId Ordering.Order.Id)
  event orderClosed()
  event blockedForDebt(orderId Ordering.Order.Id)
  event forgotten()
  error alreadyRegistered()
  error notRegistered()
  error customerBlocked()
  error alreadyHasOrder(orderId Ordering.Order.Id)
  error hasActiveOrder()
  error phoneTaken()
  query Profile() Ordering.CustomerProfile [actor Customer]
  query Home() Ordering.HomeAddress [actor Customer]
  query FindByPhone(phoneNumber string) list<Ordering.CustomerRow> [role admin, role support]
entity Ordering.Order (id uuid)
  status Ordering.OrderStatus
  customer Ordering.Customer.Id?
  route Ordering.Route
  carClass Ordering.CarClass
  price Ordering.Money
  driverName string?
  driverPlate string?
  placedAt timestamp
  tip Ordering.Money?
  costCenter string?
  index byCustomer
  index byStatus
  rule perKmRate(requestedClass Ordering.CarClass) decimal
  command place(customerId Ordering.Customer.Id, orderRoute Ordering.Route, requestedClass Ordering.CarClass)
  command PaymentCaptured(transactionId string) [role payments]
  command PaymentDeclined(reason string) [role payments]
  command LeaveTip(amount Ordering.Money) [field customer]
  command Edit(orderRoute Ordering.Route, requestedClass Ordering.CarClass) [role admin, role support]
  command Cancel(reason string) [field customer, role support, role admin]
  command writeMart()
  command markOffered()
  command resumeSearch()
  command confirmDriver(assignedName string, assignedPlate string)
  command failSearch()
  command finishRide()
  event placed(customerId Ordering.Customer.Id, orderRoute Ordering.Route, requestedClass Ordering.CarClass, orderPrice Ordering.Money, at timestamp)
  event offerPending()
  event searchResumed()
  event driverConfirmed(assignedName string, assignedPlate string)
  event searchExhausted()
  event rideFinished()
  event paymentReceived(transactionId string)
  event paymentFailed(reason string)
  event tipped(amount Ordering.Money)
  event edited(orderRoute Ordering.Route, requestedClass Ordering.CarClass, orderPrice Ordering.Money)
  event orderCancelled(reason string, at timestamp)
  notification orderPlaced(orderId Ordering.Order.Id, price Ordering.Money)
  notification driverOnTheWay(orderId Ordering.Order.Id)
  notification noDriversAvailable(orderId Ordering.Order.Id)
  notification receipt(orderId Ordering.Order.Id, amount Ordering.Money)
  notification paymentProblem(orderId Ordering.Order.Id, reason string)
  error orderAlreadyExists()
  error cannotCancel(currentStatus Ordering.OrderStatus)
  error cannotEdit(currentStatus Ordering.OrderStatus)
  error orderNotFound()
  error tipsDisabled()
  error cannotTip(currentStatus Ordering.OrderStatus)
  query MyOrders(pageReq PageRequest) page<Ordering.OrderRow> [actor Customer]
  query Card(orderId Ordering.Order.Id) Ordering.OrderCard [actor Customer]
  query List(wanted Ordering.OrderStatus, pageReq PageRequest) page<Ordering.OrderRow> [role admin, role support]
  query Details(orderId Ordering.Order.Id) Ordering.OrderDetails [role admin, role support]
  command SetCostCenter(code string) [field customer]
  event costCenterSet(code string)
  error invalidCostCenter()
  error orderLimitExceeded(limit decimal)
