actor Dispatch.Driver (id uuid)
  name string
  car Dispatch.Car
  status Dispatch.DriverStatus
  currentTrip Dispatch.Trip.Id?
  index byStatus
  index byPlate
  command Register(driverName string, driverCar Dispatch.Car) [role admin]
  command GoOnline() [self self]
  command GoOffline() [self self]
  command offerTrip(tripId Dispatch.Trip.Id, pickup Dispatch.GeoPoint, fare Dispatch.Money)
  command Accept() [self self]
  command Decline() [self self]
  command withdrawOffer(tripId Dispatch.Trip.Id)
  command FinishRide() [self self]
  command releaseTrip(tripId Dispatch.Trip.Id)
  event driverRegistered(driverName string, driverCar Dispatch.Car)
  event wentOnline()
  event wentOffline()
  event tripOffered(tripId Dispatch.Trip.Id)
  event offerAccepted()
  event offerRejectedBusy(tripId Dispatch.Trip.Id)
  event offerDeclined()
  event offerWithdrawn()
  event rideFinished()
  notification newOffer(tripId Dispatch.Trip.Id, pickup Dispatch.GeoPoint, fare Dispatch.Money)
  notification offerCancelled(tripId Dispatch.Trip.Id)
  error alreadyRegistered()
  error notRegistered()
  error alreadyOnline()
  error cannotGoOffline(currentStatus Dispatch.DriverStatus)
  error noActiveOffer()
  error noActiveRide()
  error plateTaken()
  error driverNotFound()
  query MyState() Dispatch.DriverState [actor Driver]
  query FreeDrivers(wantedClass Dispatch.CarClass, pageReq PageRequest) page<Dispatch.DriverInfo> [role dispatcher]
  query info(driverId Dispatch.Driver.Id) Dispatch.DriverInfo
external Dispatch.Matching (id uuid)
  drivers list<Dispatch.Driver.Id>
  silent bool
  request findDriver(tripId Dispatch.Trip.Id, pickup Dispatch.GeoPoint, requestedClass Dispatch.CarClass, exclude set<Dispatch.Driver.Id>, timeout Timer.Id)
  command Setup(freeDrivers list<Dispatch.Driver.Id>)
  command GoSilent()
  event configured(freeDrivers list<Dispatch.Driver.Id>)
  event silenced()
entity Dispatch.Trip.Offer (id bigint)
  driver Dispatch.Driver.Id?
  outcome Dispatch.OfferOutcome
  command open(offeredTo Dispatch.Driver.Id)
  command close(result Dispatch.OfferOutcome)
  event opened(offeredTo Dispatch.Driver.Id)
  event closed(result Dispatch.OfferOutcome)
enum Dispatch.TripStage
  searching
  offered
  assigned
  completed
  noDrivers
  cancelled
entity Dispatch.Trip (id uuid)
  stage Dispatch.TripStage
  pickup Dispatch.GeoPoint
  carClass Dispatch.CarClass
  fare Dispatch.Money
  driver Dispatch.Driver.Id?
  candidate Dispatch.Driver.Id?
  searchTimer Timer.Id?
  offerTimer Timer.Id?
  searchRetries int
  command open(pickupPoint Dispatch.GeoPoint, requestedClass Dispatch.CarClass, price Dispatch.Money)
  command update(pickupPoint Dispatch.GeoPoint, requestedClass Dispatch.CarClass, price Dispatch.Money)
  command close()
  command tip(amount Dispatch.Money)
  command findDriver()
  command DriverFound(driverId Dispatch.Driver.Id) [role matching]
  command NoDriverFound() [role matching]
  command searchTimedOut()
  command giveUp()
  command searchAgain(skipped Dispatch.Driver.Id)
  command expireOffer(driverId Dispatch.Driver.Id)
  command driverDeclined(driverId Dispatch.Driver.Id)
  command closeOffer(result Dispatch.OfferOutcome)
  command assignDriver(driverId Dispatch.Driver.Id, assignedName string, assignedPlate string)
  command finishRide(driverId Dispatch.Driver.Id)
  event searchOpened(pickupPoint Dispatch.GeoPoint, requestedClass Dispatch.CarClass, tripFare Dispatch.Money)
  event searchUpdated(pickupPoint Dispatch.GeoPoint, requestedClass Dispatch.CarClass, tripFare Dispatch.Money)
  event searchStarted(timer Timer.Id)
  event searchRetried()
  event offerSent(driverId Dispatch.Driver.Id, timer Timer.Id)
  event driverSkipped(driverId Dispatch.Driver.Id)
  event driverAssigned(driverId Dispatch.Driver.Id, assignedName string, assignedPlate string)
  event rideCompleted(at timestamp)
  event searchFailed(at timestamp)
  event dispatchClosed()
  notification rideCancelled(tripId Dispatch.Trip.Id)
  notification tipReceived(tripId Dispatch.Trip.Id, amount Dispatch.Money)
  error offerNoLongerValid()
  error rideNotActive()
enum Dispatch.DriverStatus
  offline
  free
  offered
  busy
enum Dispatch.OfferOutcome
  pending
  accepted
  declined
  expired
  withdrawn
enum Dispatch.CarClass
  economy
  comfort
enum Dispatch.Currency
  rub
value Dispatch.Money
  amount decimal
  currency Dispatch.Currency
value Dispatch.GeoPoint
  lat float
  lon float
value Dispatch.Car
  plate string
  model string
  carClass Dispatch.CarClass
value Dispatch.DriverInfo
  driverId Dispatch.Driver.Id
  name string
  plate string
value Dispatch.DriverState
  status Dispatch.DriverStatus
  currentTrip Dispatch.Trip.Id?
screen Dispatch.Shift
screen Dispatch.FreeDrivers
screen Dispatch.NewDriver
