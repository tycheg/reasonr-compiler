Subject Ordering.Customer
  fields: Ordering.Customer.phone
  parameters: Ordering.Customer.SignUp(phoneNumber), Ordering.Customer.Join(phoneNumber), Ordering.Customer.signedUp(phoneNumber), Ordering.Customer.joined(phoneNumber), Ordering.Customer.FindByPhone(phoneNumber)
  flows:
    Ordering.Customer.SignUp: phoneNumber → event Ordering.Customer.signedUp(phoneNumber)
    Ordering.Customer.Join: phoneNumber → event Ordering.Customer.joined(phoneNumber)
    Ordering.Customer.signedUp: phoneNumber → field Ordering.Customer.phone
    Ordering.Customer.joined: phoneNumber → field Ordering.Customer.phone
    Ordering.Customer.Profile: CustomerProfile(phone: c.phone, blocked: c.blocked) → result of Ordering.Customer.Profile
    Ordering.Customer.FindByPhone: [Customer]
      where phone == phoneNumber
      limit 10
      select CustomerRow(customerId: id, phone: phone) → result of Ordering.Customer.FindByPhone
  forgotten in: Ordering.Customer.Forget

