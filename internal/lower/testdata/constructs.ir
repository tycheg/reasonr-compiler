func test "A box is created"
  slots: r0 start Point, r1 k1 Keeper.Id, r2 b1 Box.Id, r3 BoxStats
  b0:
    r0 = val.new Point(x: 1, y: 2)
    r1 = newid Keeper
    r2 = newid Box
    test.cmd [r1] Keeper.Join(keeperName: "Ann") as r1
    test.time 5m
    test.when
    test.cmd [r2] Box.Create(keeper: r1, boxKind: Kind.big) as admin
    expect.request Store.save(boxId: r2)
    r3 = test.query BoxView.Total(wanted: Kind.big) as admin
    expect.matches r3 BoxStats(total: 0)
    ret

func test "Statistics"
  slots: r0 start Point, r1 BoxStats
  b0:
    r0 = val.new Point(x: 1, y: 2)
    test.when
    r1 = test.query BoxView.Total(wanted: Kind.small) as admin
    expect.matches r1 BoxStats(total: 0)
    expect.error Box.tooMany(limit: 10)
    ret
