    r4 = add.i64 r9, r23
    jmp b22
  b22:
    r12 = field kind
    r24 = intrinsic string(r12)
    r25 = intrinsic string(r4)
    r26 = intrinsic str.concat("Box ", r24, " of ", r25, " pcs.")
    r14 = field items
    r27 = intrinsic list.first(r14)
    r10 = opt.isnone r27
    br r10, b23, b24
  b23:
    r28 = move "empty"
    jmp b25
  b24:
    r28 = move r27
    jmp b25
  b25:
    r29 = move r28
    r27 = field note
    r10 = opt.isnone r27
