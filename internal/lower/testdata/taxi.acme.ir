func test "An empty cost center is rejected"
  slots: r0 Ordering.GeoPoint, r1 Ordering.GeoPoint, r2 adminRide Ordering.Route, r3 moscow Ordering.GeoPoint, r4 car1 Dispatch.Car, r5 center Ordering.GeoPoint, r6 ride Ordering.Route, r7 peakPoint Ordering.GeoPoint, r8 peakRide Ordering.Route, r9 kia Dispatch.Car, r10 lada Dispatch.Car, r11 point Ordering.GeoPoint, r12 trip Ordering.Route, r13 car Dispatch.Car, r14 here Ordering.GeoPoint, r15 hop Ordering.Route, r16 spot Ordering.GeoPoint, r17 c1 Ordering.Customer.Id, r18 o1 Ordering.Order.Id, r19 Ordering.Route
  b0:
    r0 = val.new Ordering.GeoPoint(lat: float(55.75), lon: float(37.62))
    r1 = val.new Ordering.GeoPoint(lat: float(55.8), lon: float(37.6))
    r2 = val.new Ordering.Route(from: r0, to: r1, distanceKm: float(10))
