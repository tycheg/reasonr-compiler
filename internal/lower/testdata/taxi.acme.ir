  b3:
    loop.guard
    r5 = lt.i64 r8, r7
    br r5, b4, b7
  b4:
    r9 = coll.get r6, r8
    r10 = in.set r9, r3
    r11 = not r10
    br r11, b5, b6
  b5:
    callout [r0] Dispatch.Trip.DriverFound(driverId: r9)
