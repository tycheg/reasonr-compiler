func test "A Keycloak user becomes a customer"
  slots: r0 Ordering.GeoPoint, r1 Ordering.GeoPoint, r2 adminRide Ordering.Route, r3 moscow Ordering.GeoPoint, r4 car1 Dispatch.Car, r5 center Ordering.GeoPoint, r6 ride Ordering.Route, r7 peakPoint Ordering.GeoPoint, r8 peakRide Ordering.Route, r9 kia Dispatch.Car, r10 lada Dispatch.Car, r11 point Ordering.GeoPoint, r12 trip Ordering.Route, r13 car Dispatch.Car, r14 here Ordering.GeoPoint, r15 hop Ordering.Route, r16 spot Ordering.GeoPoint, r17 u1 Auth.User.Id, r18 Ordering.Customer.Id, r19 Ordering.CustomerProfile
  b0:
    r0 = val.new Ordering.GeoPoint(lat: float(55.75), lon: float(37.62))
    r1 = val.new Ordering.GeoPoint(lat: float(55.8), lon: float(37.6))
    r2 = val.new Ordering.Route(from: r0, to: r1, distanceKm: float(10))
    r3 = val.new Ordering.GeoPoint(lat: float(55.75), lon: float(37.62))
    r4 = val.new Dispatch.Car(plate: "A001AA77", model: "Kia Rio", carClass: Dispatch.CarClass.economy)
    r5 = val.new Ordering.GeoPoint(lat: float(55.75), lon: float(37.62))
    r6 = val.new Ordering.Route(from: r5, to: r5, distanceKm: float(3))
    r7 = val.new Ordering.GeoPoint(lat: float(55.75), lon: float(37.62))
    r8 = val.new Ordering.Route(from: r7, to: r7, distanceKm: float(5))
    r9 = val.new Dispatch.Car(plate: "B002BB77", model: "Kia Rio", carClass: Dispatch.CarClass.economy)
    r10 = val.new Dispatch.Car(plate: "E003EE77", model: "Lada Vesta", carClass: Dispatch.CarClass.economy)
    r11 = val.new Ordering.GeoPoint(lat: float(55.75), lon: float(37.62))
    r12 = val.new Ordering.Route(from: r11, to: r11, distanceKm: float(3))
    r13 = val.new Dispatch.Car(plate: "K004KK77", model: "Kia Rio", carClass: Dispatch.CarClass.economy)
    r14 = val.new Ordering.GeoPoint(lat: float(55.75), lon: float(37.62))
    r15 = val.new Ordering.Route(from: r14, to: r14, distanceKm: float(2))
    r16 = val.new Ordering.GeoPoint(lat: float(55.75), lon: float(37.62))
    r17 = newid Auth.User
    test.when
    r18 = id.conv Ordering.Customer r17
    test.cmd [r18] Ordering.Customer.Join(phoneNumber: "+79990000077") as r17
    r19 = test.query Ordering.Customer.Profile() as r17
    expect.matches r19 Ordering.CustomerProfile(phone: "+79990000077", blocked: false)
    ret

