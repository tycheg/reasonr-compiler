  b0:
    r0 = id
    r1 = now
    r2 = coll.set
    r3 = inner.all Dispatch.Trip.Offer
    r4 = coll.len r3
    r5 = move 0
    jmp b1
  b1:
    loop.guard
    r6 = lt.i64 r5, r4
    br r6, b2, b5
  b2:
    r7 = coll.get r3, r5
    r8 = rec.get r7, driver
    r9 = opt.isnone r8
