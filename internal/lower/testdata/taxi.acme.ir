    r3 = intrinsic page.items(r2)
    r4 = coll.list
    r5 = coll.len r3
    r6 = move 0
    jmp b1
  b1:
    loop.guard
    r7 = lt.i64 r6, r5
    br r7, b2, b3
  b2:
    r8 = coll.get r3, r6
    r9 = rec.get r8, id
    r10 = rec.get r8, name
    r11 = rec.get r8, car
    r12 = val.get r11, plate
    r13 = val.new Dispatch.DriverInfo(driverId: r9, name: r10, plate: r12)
    r4 = coll.append r4, r13
    r6 = add.i64 r6, 1
    jmp b1
