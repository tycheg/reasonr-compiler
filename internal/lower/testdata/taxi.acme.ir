    r4 = val.new Dispatch.Car(plate: "A001AA77", model: "Kia Rio", carClass: Dispatch.CarClass.economy)
    r5 = val.new Ordering.GeoPoint(lat: float(55.75), lon: float(37.62))
    r6 = val.new Ordering.Route(from: r5, to: r5, distanceKm: float(3))
    r7 = val.new Ordering.GeoPoint(lat: float(55.75), lon: float(37.62))
    r8 = val.new Ordering.Route(from: r7, to: r7, distanceKm: float(5))
    r9 = val.new Dispatch.Car(plate: "B002BB77", model: "Kia Rio", carClass: Dispatch.CarClass.economy)
    r10 = val.new Dispatch.Car(plate: "E003EE77", model: "Lada Vesta", carClass: Dispatch.CarClass.economy)
    r11 = val.new Ordering.GeoPoint(lat: float(55.75), lon: float(37.62))
    r12 = val.new Ordering.Route(from: r11, to: r11, distanceKm: float(3))
    r13 = val.new Dispatch.Car(plate: "K004KK77", model: "Kia Rio", carClass: Dispatch.CarClass.economy)
    r14 = val.new Ordering.GeoPoint(lat: float(55.75), lon: float(37.62))
    r15 = val.new Ordering.Route(from: r14, to: r14, distanceKm: float(2))
    r16 = val.new Ordering.GeoPoint(lat: float(55.75), lon: float(37.62))
    r17 = newid Ordering.Customer
    r18 = newid Ordering.Order
    test.cmd [r17] Ordering.Customer.SignUp(phoneNumber: "+79990000030") as r17
    r19 = val.new Ordering.Route(from: r16, to: r16, distanceKm: float(2))
    test.cmd [r17] Ordering.Customer.OrderTaxi(orderId: r18, orderRoute: r19, requestedClass: Ordering.CarClass.economy) as r17
    test.when
    test.cmd [r18] Ordering.Order.SetCostCenter(code: "") as r17
    expect.error Ordering.Order.invalidCostCenter()
    ret

