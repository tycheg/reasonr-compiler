func test Antifraud freezes the account after a large transfer
  regs: r0 c1 Accounts.Client.Id, r1 c2 Accounts.Client.Id, r2 a1 Accounts.Account.Id, r3 a2 Accounts.Account.Id, r4 Accounts.AccountRow
  consts: r5 = k6, r6 = k7, r7 = k8, r8 = k9, r9 = k10, r10 = k11, r11 = k12, r12 = k2
        # contexts/Accounts/antifraud.test.rr:4
     0  newid          r0, Accounts.Client
        # contexts/Accounts/antifraud.test.rr:5
     1  newid          r1, Accounts.Client
        # contexts/Accounts/antifraud.test.rr:6
     2  newid          r2, Accounts.Account
        # contexts/Accounts/antifraud.test.rr:7
     3  newid          r3, Accounts.Account
        # contexts/Accounts/antifraud.test.rr:9
     4  test.cmd       Accounts.Antifraud.Setup(limitAmount: r5)
        # contexts/Accounts/antifraud.test.rr:10
     5  test.cmd       [r0].Accounts.Client.Join(clientName: r6) as r0
        # contexts/Accounts/antifraud.test.rr:11
     6  test.cmd       [r1].Accounts.Client.Join(clientName: r7) as r1
        # contexts/Accounts/antifraud.test.rr:12
     7  test.cmd       [r2].Accounts.Account.Open() as r0
        # contexts/Accounts/antifraud.test.rr:13
     8  test.cmd       [r3].Accounts.Account.Open() as r1
        # contexts/Accounts/antifraud.test.rr:14
     9  test.cmd       [r2].Accounts.Account.SetOverdraft(limit: r8) as compliance
        # contexts/Accounts/antifraud.test.rr:15
    10  test.when
        # contexts/Accounts/antifraud.test.rr:16
    11  test.cmd       [r2].Accounts.Account.Transfer(target: r3, sum: r9, comment: r10) as r0
        # contexts/Accounts/antifraud.test.rr:18
    12  expect.request Accounts.Antifraud.score(accountId: r2, target: r3, sum: r9)
        # contexts/Accounts/antifraud.test.rr:19
    13  test.query     r4, Accounts.Account.Details(accountId: r2) as r0
    14  expect.matches r4 matches Accounts.AccountRow(balance: r11, frozen: r12)
    15  ret

