{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "{", "close": "}", "notIn": ["comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""]
  ],
  "folding": {
    "offSide": true
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(entity|actor|value|enum|projection|external|view|migration|test|extend|command|event|query|rule|on|if|else|for|while|given|when|then)\\b.*$|^\\s*[a-z][A-Za-z0-9_]*\\(.*\\)\\s+[A-Za-z][A-Za-z0-9_<>,.? ]*$|^\\s*(return|select)?\\s*\\[[A-Z][A-Za-z0-9_]*\\]\\s*$",
    "decreaseIndentPattern": "^\\s*else\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(return|break|continue)\\b.*$",
      "action": { "indent": "outdent" }
    }
  ],
  "wordPattern": "[\\p{L}_][\\p{L}\\p{N}_]*"
}
